{
  "name": "wordcards",
  "version": "1.0.0",
  "private": true,
  "description": "18개월 이상 아이를 위한 낱말카드 (웹 + 안드로이드)",
  "scripts": {
    "serve": "python3 -m http.server 8080 -d www",
